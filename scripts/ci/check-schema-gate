#!/bin/sh
# check-schema-gate — every non-merge commit in BASE..HEAD that changes
# schema/ must anchor an ADP-A proposal whose Decision section records
# ACCEPTED (ADP-0 §5.3, §5.4).
#
# A proposal is proposals/ADP-A-NNN-<slug>.md. Its decision is recorded
# under a heading containing "Decision", as a line beginning with
# ACCEPTED (optionally after '- ', '* ' or '**'). A placeholder such as
# 'ACCEPTED | REJECTED | DEFERRED' is not a decision.
#
# Usage: scripts/ci/check-schema-gate BASE [HEAD]
# Substrate: POSIX sh, git, grep, awk, tr. Exit: 0 pass, 1 refused, 2 usage or
# a range that does not resolve. Quiet on success.

set -u

[ $# -ge 1 ] || { printf 'usage: check-schema-gate BASE [HEAD]\n' >&2; exit 2; }
base=$1
head=${2:-HEAD}
root=$(git rev-parse --show-toplevel) || exit 2

# Fail closed: a range git cannot resolve would make rev-list print an
# error and the loop below run zero times, which would read as a pass.
# The all-zero SHA is what a push that creates a branch gives as BASE.
for ref in "$base" "$head"; do
    case $ref in
        '' | *[!0]*) ;;
        *) printf '%s: %s is the all-zero SHA: no range to check\n' "$(basename "$0")" "$ref" >&2; exit 2 ;;
    esac
    git rev-parse --verify --quiet "$ref^{commit}" >/dev/null ||
        { printf '%s: cannot resolve %s to a commit\n' "$(basename "$0")" "${ref:-(empty)}" >&2; exit 2; }
done
commits=$(git rev-list --no-merges --reverse "$base..$head") || exit 2

accepted() {   # accepted ADP-A-NNN -> 0 if a proposal file records ACCEPTED
    for f in "$root"/proposals/"$1"-*.md; do
        [ -f "$f" ] || continue
        awk '
            /^#+ / { in_dec = ($0 ~ /Decision/) ; next }
            in_dec && /^[[:space:]]*([-*][[:space:]]+)?(\*\*)?ACCEPTED(\*\*)?([^A-Za-z|]|$)/ \
                   && !/ACCEPTED(\*\*)?[[:space:]]*\|/ { found = 1 }
            END { exit !found }
        ' "$f" && return 0
    done
    return 1
}

failed=0
for c in $commits; do
    git diff-tree --no-commit-id --name-only -r "$c" -- schema/ | grep -q . || continue
    subject=$(git log -1 --format=%s "$c")
    ok=no
    for p in $(printf '%s\n' "$subject" | tr -cs 'A-Z0-9-' '\n' | grep -E '^ADP-A-[0-9]+$'); do
        accepted "$p" && { ok=yes; break; }
    done
    if [ "$ok" = no ]; then
        printf '%s %s\n  changes schema/ without an ACCEPTED ADP-A proposal anchor (ADP-0 §5.4)\n' \
            "$(git rev-parse --short "$c")" "$subject" >&2
        failed=1
    fi
done

exit "$failed"
