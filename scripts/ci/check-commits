#!/bin/sh
# check-commits — run scripts/hooks/commit-msg on every non-merge commit
# in BASE..HEAD. Hooks are local and can be skipped; this is the same
# check, run where it cannot be skipped.
# Usage: scripts/ci/check-commits BASE [HEAD]
# Anchors resolve against the checked-out tree (HEAD).
#
# Optional, from the environment (set by .github/workflows/adp.yml):
#   ADP_LANDED       a commit on main. Commits reachable from it are not
#                    checked again: each was checked by the pull request
#                    that brought it to main. Set for main -> stable.
#   ADP_SIGNED_FILE  full SHAs the git host verified as signed by GitHub
#                    itself (committer noreply@github.com), one per line.
#                    A commit authored by Dependabot, listed there, whose
#                    subject has Dependabot's version-bump shape needs no
#                    anchor (eng-principles ENG-DEC-021, as hooks/check-pr).
# Substrate: POSIX sh, git, mktemp. Exit: 0 all accepted, 1 any refused,
# 2 usage or a range that does not resolve.
# Quiet on success.

set -u

[ $# -ge 1 ] || { printf 'usage: check-commits BASE [HEAD]\n' >&2; exit 2; }
base=$1
head=${2:-HEAD}

# Fail closed: a range git cannot resolve would make rev-list print an
# error and the loop below run zero times, which would read as a pass.
# The all-zero SHA is what a push that creates a branch gives as BASE.
for ref in "$base" "$head"; do
    case $ref in
        '' | *[!0]*) ;;
        *) printf '%s: %s is the all-zero SHA: no range to check\n' "$(basename "$0")" "$ref" >&2; exit 2 ;;
    esac
    git rev-parse --verify --quiet "$ref^{commit}" >/dev/null ||
        { printf '%s: cannot resolve %s to a commit\n' "$(basename "$0")" "${ref:-(empty)}" >&2; exit 2; }
done
landed=${ADP_LANDED:-}
if [ -n "$landed" ]; then
    git rev-parse --verify --quiet "$landed^{commit}" >/dev/null ||
        { printf '%s: ADP_LANDED is not a commit: %s\n' "$(basename "$0")" "$landed" >&2; exit 2; }
    set -- "^$landed"
else
    set --
fi
commits=$(git rev-list --no-merges --reverse "$base..$head" "$@") || exit 2

hooks=$(cd "$(dirname "$0")/../hooks" && pwd -P) || exit 2

dependabot_email='49699333+dependabot[bot]@users.noreply.github.com'
types=$(grep -v '^#' "$hooks/types" | grep . | paste -sd'|' -)
bump="^($types)(\([A-Za-z0-9_./-]+\))?: ([Bb]ump [^ ]+ from [^ ]+ to [^ ]+|[Bb]ump the [^ ]+ group( across [0-9]+ directories)? with [0-9]+ updates?|[Uu]pdate [^ ]+ requirement from [^ ]+ to [^ ]+)( in [^ ]+)?$"

dependabot_bump() { # dependabot_bump <full sha>
    [ -n "${ADP_SIGNED_FILE:-}" ] &&
        [ "$(git log -1 --format=%ae "$1")" = "$dependabot_email" ] &&
        grep -qx "$1" "$ADP_SIGNED_FILE" &&
        git log -1 --format=%s "$1" | grep -qE "$bump"
}
msg=$(mktemp) || exit 2
trap 'rm -f "$msg"' EXIT INT TERM

failed=0
for c in $commits; do
    dependabot_bump "$c" && continue
    git log -1 --format=%B "$c" > "$msg"
    if ! out=$(sh "$hooks/commit-msg" "$msg" 2>&1); then
        printf '%s %s\n%s\n' "$(git rev-parse --short "$c")" "$(git log -1 --format=%s "$c")" "$out" >&2
        failed=1
    fi
done

exit "$failed"
